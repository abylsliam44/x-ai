# ============================================================
# Agentic X Content Platform — environment template
# ============================================================
# This file is safe to commit. It contains NO real secrets.
# Copy it to backend/.env and fill in the values marked FILL.
# ============================================================

# --- Core ---
PROJECT_NAME="Agentic X Content Platform"
ENVIRONMENT=development
DEBUG=true
# FILL: generate with `python -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=change-me-please-use-a-strong-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Database / Cache ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agentic_x
DATABASE_SYNC_URL=postgresql+psycopg://postgres:postgres@localhost:5432/agentic_x
REDIS_URL=redis://localhost:6379/0

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_WORKER_CONCURRENCY=1

# --- Mode ---
# Keep MOCK_MODE=true for safe local dev and CI — no real API keys needed.
# Switch to false only when you have real API keys configured below.
MOCK_MODE=true

# --- LLM provider ---
# Options: mock | openai | anthropic
DEFAULT_LLM_PROVIDER=mock
ENABLE_MODEL_ROUTING=true

# FILL (required when MOCK_MODE=false and DEFAULT_LLM_PROVIDER=openai):
OPENAI_API_KEY=

# Optional OpenAI organisation / project overrides
OPENAI_BASE_URL=
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=

# --- OpenAI model tiers ---
# Agents are routed to strong (complex reasoning) vs cheap (fast/cheap tasks).
OPENAI_MODEL_STRONG=gpt-5.5
OPENAI_MODEL_CHEAP=gpt-5.4-mini
OPENAI_MODEL_DEFAULT=gpt-5.4-mini

# Legacy single-model fallback (used when ENABLE_MODEL_ROUTING=false)
OPENAI_MODEL=gpt-5.4-mini

# --- OpenAI specialised models ---
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_STT_MODEL_CHEAP=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
# Sora / video generation
OPENAI_VIDEO_MODEL=sora-2

# --- OpenAI call behaviour ---
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=3
OPENAI_MAX_OUTPUT_TOKENS=4000
OPENAI_REASONING_EFFORT=medium
OPENAI_ENABLE_WEB_SEARCH=false
OPENAI_WEB_SEARCH_MODEL=gpt-5.4-mini
OPENAI_WEB_SEARCH_CONTEXT_SIZE=low

# --- Anthropic (optional secondary provider) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Feature flags: real media generation ---
# Only enable after confirming the matching OpenAI endpoint is accessible.
ENABLE_REAL_EMBEDDINGS=false
ENABLE_REAL_IMAGE_GENERATION=false
ENABLE_REAL_STT=false
ENABLE_REAL_TTS=false
ENABLE_REAL_VIDEO_GENERATION=false

# --- Media / Search providers ---
DEFAULT_IMAGE_PROVIDER=mock
DEFAULT_AUDIO_PROVIDER=mock
DEFAULT_VIDEO_PROVIDER=mock
DEFAULT_SEARCH_PROVIDER=mock

# --- X / Twitter integration ---
# FILL (required when ENABLE_REAL_X_API=true):
ENABLE_REAL_X_API=false
X_CLIENT_ID=
X_CLIENT_SECRET=

# Redirect URI — must match exactly what is registered in the X Developer Portal.
X_REDIRECT_URI=http://localhost:8000/api/v1/x/callback

# X API base URL (includes /2 path prefix)
X_API_BASE_URL=https://api.x.com/2

# OAuth 2.0 endpoints
X_OAUTH_AUTHORIZE_URL=https://x.com/i/oauth2/authorize
X_OAUTH_TOKEN_URL=https://api.x.com/2/oauth2/token

# OAuth scopes (JSON array required by pydantic-settings)
X_SCOPES=["tweet.read","tweet.write","users.read","offline.access"]

# --- X media upload feature flags ---
X_ENABLE_REAL_MEDIA_UPLOAD=false
X_ENABLE_REAL_IMAGE_UPLOAD=false
X_ENABLE_REAL_VIDEO_UPLOAD=false
ENABLE_REAL_X_SEARCH=false
X_MAX_IMAGES_PER_POST=4

# --- Storage ---
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT_URL=

# --- Limits ---
MAX_CONCURRENT_GENERATIONS=2
MAX_UPLOAD_SIZE_MB=100
MAX_VIDEO_DURATION_SECONDS=140
MAX_IMAGES_PER_POST=4
MAX_VIDEO_SIZE_MB=512
MAX_GIF_SIZE_MB=15

# --- Feature flags ---
ENABLE_PGVECTOR=false
ENABLE_REAL_WEB_SEARCH=false

# --- RAG ---
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=6

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=text
