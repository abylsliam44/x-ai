# --- Core ---
PROJECT_NAME="Agentic X Content Platform"
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-please-use-a-strong-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Database / Cache ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agentic_x
DATABASE_SYNC_URL=postgresql+psycopg://postgres:postgres@localhost:5432/agentic_x
REDIS_URL=redis://localhost:6379/0

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_WORKER_CONCURRENCY=1

# --- LLM ---
DEFAULT_LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Media / Search providers (mock by default) ---
DEFAULT_IMAGE_PROVIDER=mock
DEFAULT_AUDIO_PROVIDER=mock
DEFAULT_VIDEO_PROVIDER=mock
DEFAULT_SEARCH_PROVIDER=mock

# --- X / Twitter ---
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:8000/api/v1/x/callback
X_API_BASE_URL=https://api.twitter.com/2

# --- Storage ---
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT_URL=

# --- Limits (recommended for 2 vCPU / 2 GB RAM) ---
MAX_CONCURRENT_GENERATIONS=2
MAX_UPLOAD_SIZE_MB=100
MAX_VIDEO_DURATION_SECONDS=140
MAX_IMAGES_PER_POST=4
MAX_VIDEO_SIZE_MB=512
MAX_GIF_SIZE_MB=15

# --- Feature flags ---
ENABLE_PGVECTOR=false
ENABLE_REAL_X_API=false
ENABLE_REAL_MEDIA_GENERATION=false
ENABLE_REAL_WEB_SEARCH=false
MOCK_MODE=true

# --- RAG ---
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=6

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=text
