# ============================================================
# Agentic X Content Platform — PRODUCTION environment template
# ============================================================
# Copy this file to backend/.env on the server, then fill in
# every value marked with FILL below.  NEVER commit .env.
# ============================================================

# --- Core ---
PROJECT_NAME="Agentic X Content Platform"
ENVIRONMENT=production
DEBUG=false
# FILL: generate with `python -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=FILL_ME_STRONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Database / Cache ---
# These are overridden by docker-compose.prod.yml to use container hostnames.
# Only change if you are NOT using Docker Compose.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/agentic_x
DATABASE_SYNC_URL=postgresql+psycopg://postgres:postgres@postgres:5432/agentic_x
REDIS_URL=redis://redis:6379/0

# --- Celery ---
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_WORKER_CONCURRENCY=2

# --- Mode ---
# Production uses real APIs.  Switch to true only for quick debugging.
MOCK_MODE=false

# --- LLM provider ---
DEFAULT_LLM_PROVIDER=openai
ENABLE_MODEL_ROUTING=true

# FILL: your OpenAI API key
OPENAI_API_KEY=FILL_ME_YOUR_OPENAI_API_KEY

# Optional — leave empty unless you use a custom base URL / org / project
OPENAI_BASE_URL=
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=

# --- OpenAI model tiers ---
OPENAI_MODEL_STRONG=gpt-5.5
OPENAI_MODEL_CHEAP=gpt-5.4-mini
OPENAI_MODEL_DEFAULT=gpt-5.4-mini
OPENAI_MODEL=gpt-5.4-mini

# --- OpenAI specialised models ---
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_STT_MODEL_CHEAP=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
OPENAI_VIDEO_MODEL=sora-2

# --- OpenAI call behaviour ---
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=3
OPENAI_MAX_OUTPUT_TOKENS=4000
OPENAI_REASONING_EFFORT=medium
OPENAI_ENABLE_WEB_SEARCH=false
OPENAI_WEB_SEARCH_MODEL=gpt-5.4-mini
OPENAI_WEB_SEARCH_CONTEXT_SIZE=low

# --- Anthropic (optional secondary provider) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Feature flags: real media generation ---
# Enable only after confirming the matching OpenAI endpoint is accessible.
ENABLE_REAL_EMBEDDINGS=true
ENABLE_REAL_IMAGE_GENERATION=true
ENABLE_REAL_STT=false
ENABLE_REAL_TTS=false
ENABLE_REAL_VIDEO_GENERATION=false

# --- Media / Search providers ---
DEFAULT_IMAGE_PROVIDER=openai
DEFAULT_AUDIO_PROVIDER=mock
DEFAULT_VIDEO_PROVIDER=mock
DEFAULT_SEARCH_PROVIDER=openai

# --- X / Twitter integration ---
# FILL: your X Developer app credentials
ENABLE_REAL_X_API=true
X_CLIENT_ID=FILL_ME_YOUR_X_CLIENT_ID
X_CLIENT_SECRET=FILL_ME_YOUR_X_CLIENT_SECRET

# FILL: must match exactly what is registered in the X Developer Portal
X_REDIRECT_URI=https://YOUR_DOMAIN.com/api/v1/x/callback

X_API_BASE_URL=https://api.x.com/2
X_OAUTH_AUTHORIZE_URL=https://x.com/i/oauth2/authorize
X_OAUTH_TOKEN_URL=https://api.x.com/2/oauth2/token
X_SCOPES=["tweet.read","tweet.write","users.read","offline.access"]

# --- X media upload feature flags ---
X_ENABLE_REAL_MEDIA_UPLOAD=true
X_ENABLE_REAL_IMAGE_UPLOAD=true
X_ENABLE_REAL_VIDEO_UPLOAD=false
ENABLE_REAL_X_SEARCH=false
X_MAX_IMAGES_PER_POST=4

# --- Storage ---
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=/app/storage

# S3-compatible storage (Cloudflare R2, AWS S3, MinIO) — optional
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT_URL=

# --- Limits ---
MAX_CONCURRENT_GENERATIONS=2
MAX_UPLOAD_SIZE_MB=100
MAX_VIDEO_DURATION_SECONDS=140
MAX_IMAGES_PER_POST=4
MAX_VIDEO_SIZE_MB=512
MAX_GIF_SIZE_MB=15

# --- Feature flags ---
ENABLE_PGVECTOR=false
ENABLE_REAL_WEB_SEARCH=true

# --- RAG ---
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=6

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=["https://YOUR_DOMAIN.com","https://www.YOUR_DOMAIN.com"]

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
